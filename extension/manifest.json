{
  "manifest_version": 3,
  "name": "PrivacyBrew",
  "description": "See and block trackers, ads, cookie pop-ups, and fingerprinting signals in your browser.",
  "version": "1.0.0",
  "action": {
    "default_title": "PrivacyBrew",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webRequest",
    "webNavigation",
    "storage",
    "declarativeNetRequest",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ad-cosmetic.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vendor/autoconsent/content.bundle.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "cookie-fallback.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ad-wall.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_easylist",
        "enabled": true,
        "path": "rules/ads_easylist.json"
      },
      {
        "id": "allow_same_company",
        "enabled": true,
        "path": "rules/allow_same_company.json"
      },
      {
        "id": "block_advertising",
        "enabled": true,
        "path": "rules/block_advertising.json"
      },
      {
        "id": "block_analytics",
        "enabled": true,
        "path": "rules/block_analytics.json"
      },
      {
        "id": "block_social",
        "enabled": true,
        "path": "rules/block_social.json"
      },
      {
        "id": "block_fingerprinting",
        "enabled": true,
        "path": "rules/block_fingerprinting.json"
      },
      {
        "id": "block_cryptomining",
        "enabled": true,
        "path": "rules/block_cryptomining.json"
      },
      {
        "id": "gpc_headers",
        "enabled": true,
        "path": "rules/gpc_headers.json"
      },
      {
        "id": "dnt_headers",
        "enabled": false,
        "path": "rules/dnt_headers.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data/easylist_generic.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "homepage_url": "https://privacybrew.app/extension.html",
  "minimum_chrome_version": "119"
}
